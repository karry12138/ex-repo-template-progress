# ==========================================================================
#  .gitignore
#  入库：源码、数据索引、说明与进展文档。
#  不入库：检查点、运行产物、缓存、虚拟环境、本地路径配置。
# ==========================================================================

# ---- 运行工作区（_common.sh 自动创建）----
work/outputs/
work/logs/
work/reports/
work/tmp/
work/data_index/
work/checkpoints/
work/*
!work/README.md

# ---- 本地路径（保留 paths.env.example）----
paths.env
!paths.env.example

# ---- 虚拟环境（体积大，通常是 symlink；冻结清单可入库）----
venv/
.venv/
env/
00_envs/venv
00_envs/venv/

# ---- 重型外部资产 ----
06_external_links/*
!06_external_links/README.md

# ---- 检查点（大、可再生成；需要入库时改这里或用 Git LFS）----
02_checkpoints/*
!02_checkpoints/README.md

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- 本地私有配置 ----
.env
.env.*
!.env.example
