# ============================================================================
#  paths.env.example — 复制为 paths.env 后按本机修改。
#  04_entrypoints/_common.sh 会自动 source 它。
#  <...> 为占位符，请换成真实目录名或绝对路径。
# ============================================================================

# 仓库根目录。入口脚本会自动设置；单独 source 本文件时再取消注释。
# export BUNDLE_ROOT=/path/to/<repo-name>

# ---- 重型资产：仓库内 symlink，或直接写绝对路径 ----
export MODEL_DIR="${MODEL_DIR:-$BUNDLE_ROOT/06_external_links/<MODEL_NAME>}"
export DATA_DIR="${DATA_DIR:-$BUNDLE_ROOT/06_external_links/<DATASET_NAME>}"

# ---- Python 环境 ----
export VENV="${VENV:-$BUNDLE_ROOT/00_envs/venv}"
export PYTHON_BIN="${PYTHON_BIN:-$VENV/bin/python}"

# ---- 仓库内布局 ----
export EXP_ROOT="${EXP_ROOT:-$BUNDLE_ROOT/work}"
export CODE_ROOT="${CODE_ROOT:-$BUNDLE_ROOT/01_code/<PKG>}"
export CHECKPOINT_DIR="${CHECKPOINT_DIR:-$BUNDLE_ROOT/02_checkpoints/<CHECKPOINT_NAME>}"

# 主数据索引。更多索引请追加 DATA_INDEX_<名字>，_common.sh 会一并链到 work/data_index/。
export DATA_INDEX="${DATA_INDEX:-$BUNDLE_ROOT/03_data/data_index/<INDEX_NAME>.jsonl}"
# export DATA_INDEX_TRAIN="${DATA_INDEX_TRAIN:-$BUNDLE_ROOT/03_data/data_index/<INDEX_TRAIN>.jsonl}"

# 多个代码目录时同样追加 CODE_ROOT_<名字>。
# export CODE_ROOT_EXTRA="${CODE_ROOT_EXTRA:-$BUNDLE_ROOT/01_code/<OTHER_PKG>}"
