# ============================================================================
#  paths.env.example  —  copy to paths.env and edit after pointing this repo
#  at your own assets.  source this file before any run_*.sh (done by
#  04_entrypoints/_common.sh automatically).
# ============================================================================

# ---- Bundle root (auto-detected by entrypoints if unset) --------------------
# export BUNDLE_ROOT=/path/to/<repo-name>

# ---- Heavy assets: point at local copies under 06_external_links ------------
#      or absolute paths (model, datasets).  Generic placeholders; rename to
#      match your real assets.
export MODEL="${MODEL:-$BUNDLE_ROOT/06_external_links/<MODEL_NAME>}"
export DATASET_IMAGES_TRAFFIC="${DATASET_IMAGES_TRAFFIC:-$BUNDLE_ROOT/06_external_links/<DATASET_TRAFFIC>}"
export DATASET_IMAGES_CONFLICT="${DATASET_IMAGES_CONFLICT:-$BUNDLE_ROOT/06_external_links/<DATASET_CONFLICT>}"

# ---- Python envs (venv-base: has accel kernels; venv-nofla: hard-blocks them)
export VENV_FLA="${VENV_FLA:-$BUNDLE_ROOT/00_envs/venv-base}"
export VENV_NOFLA="${VENV_NOFLA:-$BUNDLE_ROOT/00_envs/venv-nofla}"
export FLA_PY="${FLA_PY:-$VENV_FLA/bin/python}"
export NOFLA_PY="${NOFLA_PY:-$VENV_NOFLA/bin/python}"
export QTY_PY="$FLA_PY"
export PYTHON_BIN="${PYTHON_BIN:-$FLA_PY}"

# ---- Workspace layout used by scripts (EXP_ROOT = writable work tree) -------
export EXP_ROOT="${EXP_ROOT:-$BUNDLE_ROOT/work}"
export QTY_ROOT="${QTY_ROOT:-$BUNDLE_ROOT/01_code/<MAIN_PKG>}"
export PKG_ROOT="${PKG_ROOT:-$BUNDLE_ROOT/01_code/<SWEEP_PKG>}"
export ADAPTER_DIR="${ADAPTER_DIR:-$BUNDLE_ROOT/02_checkpoints/<ADAPTER_NAME>}"

# ---- Data index jsonl index files -------------------------------------------
export DATASET="${DATASET:-$BUNDLE_ROOT/03_data/data_index/<INDEX_FULL>.jsonl}"
export TRAFFIC_JSONL="${TRAFFIC_JSONL:-$BUNDLE_ROOT/03_data/data_index/<INDEX_TRAFFIC>.jsonl}"
export CONFLICT_JSONL="${CONFLICT_JSONL:-$BUNDLE_ROOT/03_data/data_index/<INDEX_CONFLICT>.jsonl}"
